@page
@model TIENDA_WEB1.Pages.Productos.IndexModel

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Crear nuevo</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Producto[0].Nombre)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Producto[0].Precio)
            </th>

            <th>
                Stock
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Producto[0].FechaRegistro)
            </th>

            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Producto)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Precio)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Stock)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.FechaRegistro)
                </td>

                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id">Detalles</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>